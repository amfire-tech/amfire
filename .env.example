# Copy to .env.local for local overrides. Every value is optional for local
# development: without them the app uses an embedded database and on-screen
# sign-in links. On Vercel, set these in Project → Settings → Environment Variables.

# --- Database (Supabase Postgres) ---------------------------------------------
# Transaction pooler connection string (port 6543) for the app on Vercel:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Optional: direct or session-pooler URL (port 5432) used only for migrations:
# MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Supabase CA certificate (Database settings → SSL) so TLS is verified. "\n" sequences are fine.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# --- Auth (Supabase) -----------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (or NEXT_PUBLIC_SUPABASE_ANON_KEY)

# Owner account created on first start
# OWNER_EMAIL=you@your-domain.in
# OWNER_NAME=Your Name

# --- AI (Google Gemini) -------------------------------------------------------------
# Enables "Re-run with Gemini" in HQ. Without it, the rules engine is used.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# Optional, for cost monitoring (USD per million tokens for your model):
# GEMINI_PRICE_INPUT=
# GEMINI_PRICE_OUTPUT=

# --- AI team schedule -----------------------------------------------------------------
# Vercel Cron calls /api/cron/agents every morning at 8:00 IST (vercel.json) with this
# secret. Set any long random string; Vercel sends it automatically.
# CRON_SECRET=

# --- Getting paid -------------------------------------------------------------------
# GST is charged only when AMFIRE_GSTIN is set (a business must be GST-registered to
# charge it). Rate in basis points (1800 = 18%). AMFIRE_STATE decides CGST + SGST
# (client in the same state) or IGST (another state). SAC 998314 = IT design and development.
# AMFIRE_GSTIN=
# GST_RATE_BP=1800
# AMFIRE_STATE=Maharashtra
# AMFIRE_SAC=998314
# Printed at the top of every invoice ("\n" for new lines).
# AMFIRE_LEGAL_NAME="AMFIRE"
# AMFIRE_ADDRESS="Office address\nCity, State PIN"
# Days a client has to pay a sent invoice.
# PAYMENT_TERMS_DAYS=7
# UPI ID shown on invoices, with a "Pay with any UPI app" button.
# PAYMENT_UPI_ID=amfire@okhdfcbank
# PAYMENT_PAYEE_NAME=AMFIRE
# Bank details shown on invoices ("\n" for new lines).
# PAYMENT_BANK_DETAILS="AMFIRE\nHDFC Bank · A/c 000000000000\nIFSC HDFC0000000"
# Razorpay: payment links on sent invoices, and payments recorded automatically.
# Webhook URL: https://your-domain.in/api/webhooks/razorpay (event: payment_link.paid)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Brief delivery -----------------------------------------------------------------
# Email (Resend): the morning brief to OWNER_EMAIL, and approved email messages.
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL="AMFIRE <hello@amfire.in>"
# WhatsApp Business Cloud API: the morning brief to your own WhatsApp.
# Outside a 24-hour chat window Meta requires an approved template with one body parameter.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# OWNER_WHATSAPP=919373010143
# WHATSAPP_BRIEF_TEMPLATE=

# --- Site --------------------------------------------------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL=hello@amfire.in
# NEXT_PUBLIC_CONTACT_PHONE="+91 93730 10143"
# NEXT_PUBLIC_SITE_URL=https://your-domain.in
# PRICING_CURRENCY=INR
# Comma-separated public profiles (LinkedIn company page, Instagram…) for search engines:
# NEXT_PUBLIC_SOCIAL_PROFILES=https://www.linkedin.com/company/amfire-ai/,https://www.instagram.com/amfire

# --- Analytics (Google Analytics 4) ----------------------------------------------
# Measurement ID from GA4 → Admin → Data streams. Without it, nothing is tracked.
# Mark generate_lead, whatsapp_click and call_click as key events in GA4.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
